{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tinypinglite/sakuramedia-plugin-market/main/schema/plugin.schema.json",
  "title": "SakuraMedia 插件市场元数据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plugin_id",
    "display_name",
    "description",
    "author",
    "repo",
    "homepage",
    "categories",
    "official"
  ],
  "properties": {
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64,
      "description": "与插件 manifest.json 的 plugin_id 一致，也是元数据文件名"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "display_name_i18n": {
      "type": "object",
      "description": "插件展示名的多语言翻译，键是语言标签（zh-CN / en）。由 scripts/build_index.py 从已发布 Release 的 manifest 同步，不手写。",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description_i18n": {
      "type": "object",
      "description": "插件简介的多语言翻译，键是语言标签（zh-CN / en）。由 scripts/build_index.py 从已发布 Release 的 manifest 同步，不手写。",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
      "description": "公开的 GitHub 仓库（owner/name）。source=market 时指向市场仓；source=external 时是插件源码仓，Release 里提供插件 zip，tag 为 v<version> 或 <plugin_id>-v<version>（一个仓放多个插件时）"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "icon": {
      "type": ["string", "null"],
      "description": "可选图标 URL；为空时客户端展示默认图标"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "storage",
          "metadata",
          "discovery",
          "automation",
          "subtitle",
          "other"
        ]
      }
    },
    "official": {
      "type": "boolean",
      "description": "官方维护的插件为 true，社区投稿为 false"
    },
    "source": {
      "type": "string",
      "enum": [
        "market",
        "external"
      ],
      "default": "external",
      "description": "market：官方插件，由市场仓 Release 分发编译产物，latest 由发版 Action 写入；external：社区插件或独立公开仓的官方插件，从 repo 的最新 Release 同步。缺省按 external 处理"
    },
    "latest": {
      "type": "object",
      "description": "由 scripts/build_index.py 或官方发版 Action 自动同步，投稿时不要手写",
      "additionalProperties": false,
      "required": [
        "version",
        "host_api_version",
        "download_url",
        "sha256",
        "published_at"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "host_api_version": {
          "type": "integer",
          "minimum": 1
        },
        "download_url": {
          "type": "string",
          "format": "uri"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "published_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "const": "market"
          }
        }
      },
      "then": {
        "required": [
          "latest"
        ]
      }
    }
  ]
}
